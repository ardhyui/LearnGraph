# Postgres connection string. Leave unset locally to use embedded PGlite.
DATABASE_URL=

# Session signing secret (required in production): openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public base URL in production, e.g. https://learngraph.vercel.app
BETTER_AUTH_URL=

# Optional: persist local PGlite data between restarts
# PGLITE_DATA_DIR=.data/pglite
